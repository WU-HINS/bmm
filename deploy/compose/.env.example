# ---------------------------------------------------------------------------
# BMM 示例编排环境变量
#   复制为 .env 后按需修改：cp .env.example .env
#   生成密钥：openssl rand -hex 32
# ---------------------------------------------------------------------------

# ---------- 镜像 ----------
# 正式版本用 latest / vX.Y.Z；验证 CI 镜像可用 ci-<短SHA>（每次 push 产出）
BMM_IMAGE=ghcr.io/wu-hins/bmm
BMM_TAG=latest

# ---------- 端口与域名 ----------
BMM_PORT=3000
# 仅 with-caddy.yml 使用；需先把该域名解析到宿主机
BMM_DOMAIN=bmm.example.com
ACME_EMAIL=admin@example.com

# ---------- 必填 ----------
# 用户实际访问的地址，带协议不带结尾斜杠
AUTH_URL=https://bmm.example.com
# 会话/绑定意图的加密密钥，务必替换为随机值
AUTH_SECRET=replace-with-openssl-rand-hex-32

# ---------- 站点 ----------
NEXT_PUBLIC_WEBSITE_NAME=BMM

# ---------- PostgreSQL（postgres.yml 使用）----------
POSTGRES_DB=bmm
POSTGRES_USER=bmm
POSTGRES_PASSWORD=replace-with-strong-password

# ---------- GitHub OAuth（可选）----------
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ---------- OIDC（可选，三项齐备才启用）----------
# IdP 侧需要登记两个回调地址：
#   登录：{AUTH_URL}/api/auth/callback/oidc
#   绑定：{AUTH_URL}/api/auth/oidc/link/callback
AUTH_OIDC_ISSUER=
AUTH_OIDC_ID=
AUTH_OIDC_SECRET=
AUTH_OIDC_NAME=
AUTH_OIDC_ICON=
# 是否允许按邮箱把 OIDC 身份合并进已有账户，默认关闭
AUTH_OIDC_TRUST_EMAIL=false
